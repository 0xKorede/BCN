# Copy this file to .env.local and fill in the real values.
# Do NOT commit .env.local to git.

# Supabase — find these in your project's API settings
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend — create an API key at resend.com/api-keys
RESEND_API_KEY=
# The From address (must be a verified domain or resend sandbox)
RESEND_FROM_EMAIL=BCN Hangout <noreply@buildingcreativesnetwork.com>

# Staff admin page password (choose something strong)
ADMIN_PASSWORD=

# Public site URL — used to build QR code check-in URLs
NEXT_PUBLIC_SITE_URL=https://buildingcreativesnetwork.com
